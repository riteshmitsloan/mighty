# Browser-visible Supabase values only. Never place model or service keys in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase edge function environment
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only after provider no-training/retention controls are verified for your account.
AI_PROCESSING_ENABLED=false
AI_PROVIDER_DATA_CONTROLS_CONFIRMED=false
GEMINI_PAID_PROJECT_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=
OPENAI_API_KEY=
# Models and rates are controlled in the private ai_config database registry.
OPENAI_DRAFT_MODEL=gpt-6-astra
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
APP_URL=http://localhost:5173
