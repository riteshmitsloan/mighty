{
  "manifest_version": 3,
  "name": "Mighty",
  "version": "0.3.10",
  "description": "Mighty. Intentional, intelligent networking.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mighty: connect your account",
    "default_icon": {
      "16": "assets/icons/mighty-disconnected-16.png",
      "24": "assets/icons/mighty-disconnected-24.png",
      "32": "assets/icons/mighty-disconnected-32.png",
      "48": "assets/icons/mighty-disconnected-48.png"
    }
  },
  "icons": {
    "16": "assets/icons/mighty-connected-16.png",
    "48": "assets/icons/mighty-connected-48.png",
    "128": "assets/icons/mighty-connected-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/search/results/people/*",
        "https://linkedin.com/in/*",
        "https://linkedin.com/search/results/people/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://riteshmitsloan.github.io/mighty/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mighty-ui.woff2"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ]
}
